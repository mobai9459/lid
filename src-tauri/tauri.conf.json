{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lid",
  "version": "0.1.0",
  "identifier": "com.shamo.lid",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "合盖睡眠助手",
        "width": 420,
        "height": 180,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
